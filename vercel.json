{
  "version": 2,
  "buildCommand": "cd src/hourly_analysis && python3 build.py && cd ../.. && python3 -m pip install -r requirements.txt",
  "builds": [
    {
      "src": "src/web/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/first-hour/(.*)",
      "dest": "/public/first-hour/$1"
    },
    {
      "src": "/first-hour",
      "dest": "/public/first-hour/index.html"
    },
    {
      "src": "/intraday/(.*)",
      "dest": "/public/intraday/$1"
    },
    {
      "src": "/intraday",
      "dest": "/public/intraday/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/src/web/wsgi.py"
    }
  ],
  "env": {
    "PYTHONPATH": "."
  },
  "github": {
    "silent": true
  }
}
